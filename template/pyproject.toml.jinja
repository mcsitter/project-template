[project]
name = "{{ project_name_kebab_case }}"
version = "0.1.0"
description = "{{ project_description }}"
requires-python = ">={{ python_version }}"
dependencies = []

{%- if project_type == "app" %}

[project.scripts]
{{ project_name_snake_case }} = "{{ project_name_snake_case }}.main:main"

{%- endif %}

[project.optional-dependencies]
dev = [
  "copier",
{%- if typing %}
  "mypy",
{%- endif %}
  "{{ pre_commit_tool }}",
{%- if project_type == "app" %}
  "python-dotenv",
{%- endif %}
]

{%- if project_name_snake_case != "project_template" %}

[tool.setuptools]
package-dir = { "" = "src" }

[tool.setuptools.packages.find]
where = ["src"]

{%- endif %}

[build-system]
requires = ["setuptools", "wheel"]
build-backend = "setuptools.build_meta"

[tool.ruff]
line-length = 88
{%- if project_name_snake_case == "project_template" %}
extend-exclude = [
  "*{{ '{{' }}*{{ '}}' }}*",
  "*{{ '{%' }}*{{ '%}' }}*",
]
{%- endif %}

[tool.ruff.lint]
select = ["ALL"]
ignore = [
  "COM812",
  "CPY001",
  "D203",
  "D213",
  "S311",
]

{%- if typing %}

[tool.mypy]
ignore_missing_imports = true
{%- endif %}

{%- if with_conventional_commits %}

[tool.commitizen]
name = "cz_conventional_commits"
tag_format = "$version"
version_scheme = "pep440"
version_provider = "pep621"
update_changelog_on_bump = true
major_version_zero = true
{%- endif %}
