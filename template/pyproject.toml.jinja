[project]
name = "{{ project_name_kebab_case }}"
version = "0.1.0"
description = "{{ project_description }}"
requires-python = ">={{ python_version }}"
dependencies = []
{%- if project_type == "app" %}

[project.scripts]
{{ project_name_kebab_case }} = "{{ project_name_snake_case }}.main:main"
{%- endif %}

[dependency-groups]
dev = [
  "copier",
  "coverage[toml]",
{%- if typing %}
  "mypy",
{%- endif %}
  "prek",
  "pytest",
{%- if project_type == "app" %}
  "python-dotenv",
{%- endif %}
  { include-group = "types" },
]
types = []

[build-system]
requires = ["setuptools", "wheel"]
build-backend = "setuptools.build_meta"
{%- if with_conventional_commits %}

[tool.commitizen]
name = "cz_conventional_commits"
tag_format = "$version"
version_scheme = "pep440"
version_provider = "pep621"
update_changelog_on_bump = true
major_version_zero = true
{%- endif %}

[tool.coverage.run]
branch = true
source = ["src"{% if project_name_snake_case == "project_template" %}, "scripts"{% endif %}]
omit = ["*/__main__.py", "*/.venv/*"]

# A floor, not a target. It exists to catch a large regression; it is not a
# reason to write a test that only executes lines. Raise it deliberately.
# The template itself is excluded: its scripts are thin subprocess wrappers, and
# a floor there would only buy tests that execute lines.
[tool.coverage.report]
fail_under = {% if project_name_snake_case == "project_template" %}0{% else %}60{% endif %}
show_missing = true
skip_covered = false
{%- if typing %}

[tool.mypy]
ignore_missing_imports = true
{%- endif %}

[tool.pytest.ini_options]
addopts = ["-q"]
testpaths = ["tests"]

[tool.ruff]
line-length = 88
output-format = "concise"
{%- if project_name_snake_case == "project_template" %}
extend-exclude = [
  '*\{\{*\}\}*',
  '*\{\%*\%\}*',
]
{%- endif %}

[tool.ruff.lint]
select = ["ALL"]
ignore = [
  "COM812",  # https://docs.astral.sh/ruff/rules/missing-trailing-comma/
  "CPY001",  # https://docs.astral.sh/ruff/rules/missing-copyright-notice/
  "D203",  # https://docs.astral.sh/ruff/rules/incorrect-blank-line-before-class/
  "D213",  # https://docs.astral.sh/ruff/rules/multi-line-summary-second-line/
  "S311",  # https://docs.astral.sh/ruff/rules/suspicious-non-cryptographic-random-usage/
]

[tool.ruff.lint.per-file-ignores]
"tests/*.py" = [
  "D100",  # Ignore missing module docstrings in tests  # https://docs.astral.sh/ruff/rules/undocumented-public-module/
  "D103",  # Ignore missing function docstrings in tests  # https://docs.astral.sh/ruff/rules/undocumented-public-function/
  "INP001",  # Ignore implicit namespace packages in tests  # https://docs.astral.sh/ruff/rules/implicit-namespace-package/
  "S101",  # Ignore assert statements in tests  # https://docs.astral.sh/ruff/rules/assert/
]
"scripts/*.py" = [
  "C901",  # https://docs.astral.sh/ruff/rules/complex-structure/
  "INP001",  # https://docs.astral.sh/ruff/rules/implicit-namespace-package/
  "PLR0911",  # https://docs.astral.sh/ruff/rules/too-many-return-statements/
  "PLR0912",  # https://docs.astral.sh/ruff/rules/too-many-branches/
  "S603",  # https://docs.astral.sh/ruff/rules/subprocess-without-shell-equals-true/
  "T201",  # https://docs.astral.sh/ruff/rules/print/
]
"template/tests/*.py" = [
  "D100",  # Ignore missing module docstrings in tests  # https://docs.astral.sh/ruff/rules/undocumented-public-module/
  "D103",  # Ignore missing function docstrings in tests  # https://docs.astral.sh/ruff/rules/undocumented-public-function/
  "INP001",  # Ignore implicit namespace packages in tests  # https://docs.astral.sh/ruff/rules/implicit-namespace-package/
  "S101",  # Ignore assert statements in tests  # https://docs.astral.sh/ruff/rules/assert/
]
"template/scripts/*.py" = [
  "C901",  # https://docs.astral.sh/ruff/rules/complex-structure/
  "INP001",  # https://docs.astral.sh/ruff/rules/implicit-namespace-package/
  "PLR0911",  # https://docs.astral.sh/ruff/rules/too-many-return-statements/
  "PLR0912",  # https://docs.astral.sh/ruff/rules/too-many-branches/
  "S603",  # https://docs.astral.sh/ruff/rules/subprocess-without-shell-equals-true/
  "T201",  # https://docs.astral.sh/ruff/rules/print/
]

[tool.ruff.lint.flake8-type-checking]
runtime-evaluated-base-classes = ["pydantic.BaseModel"]
{%- if project_name_snake_case != "project_template" %}

[tool.setuptools]
package-dir = { "" = "src" }

[tool.setuptools.packages.find]
where = ["src"]
{%- endif %}
