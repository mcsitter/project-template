{
  "name": "{{ project_name_kebab_case }}",
  "image": "mcr.microsoft.com/devcontainers/python:3-{{ python_version }}",
  "features": {},
  "mounts": [
    "source=${localEnv:HOME}/.cache/pip,target=/home/vscode/.cache/pip,type=bind",
    "source=${localEnv:HOME}/.cache/{{ pre_commit_tool }},target=/home/vscode/.cache/{{ pre_commit_tool }},type=bind",
    "source=${localEnv:HOME}/.cache/uv,target=/home/vscode/.cache/uv,type=bind"
  ],
  "remoteUser": "vscode",
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.cache",
  "postStartCommand": "make sync",
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker",
        {%- if typing %}
        "ms-python.mypy-type-checker",
        {%- endif %}
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml"
      ]
    }
  }
}
