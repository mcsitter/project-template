.DEFAULT_GOAL := help
MAKEFLAGS += --no-print-directory

{%- set phony_targets = ["build", "cd", "check", "ci", "clean", "help", "init", "install", "test"] %}
{%- if is_template %}
{%- set phony_targets = phony_targets + ["test-template"] %}
{%- endif %}
{%- if project_type == "app" %}
{%- set phony_targets = phony_targets + ["run"] %}
{%- endif %}
.PHONY: {{ phony_targets | sort | join(" ") }}

UV ?= uv

## Show available commands.
help:
	@echo ""
	@echo "{{ project_name }}"
	@echo ""
	@echo "Usage:"
	@echo "  make <target>"
	@echo ""
	@echo "Typical workflow:"
	@echo "  make install                  Install development dependencies"
	@echo "  make check                    Validate code{% if project_type == 'app' %}/config{% endif %}"
	@echo "  make test                     Run tests{% if project_type == 'app' %}/integration tests{% endif %}"
	@echo "  make build                    {% if project_type == 'app' %}Build Docker image{% else %}Build wheel/sdist{% endif %}"
	@echo "  make ci                       check + test + build"
	@echo "  make cd                       {% if project_type == 'app' %}Deploy application{% else %}Publish package{% endif %}"
	@echo "  make clean                    Remove build artifacts"
{%- if project_type == "app" %}
	@echo "  make run                      Run the app"
{%- endif %}
	@echo ""
	@echo "All targets:"
	@awk '/^## / {desc=$$0; sub(/^## /,"",desc)} /^[a-zA-Z_-]+:/ && $$0 !~ /^[a-zA-Z_-]+:[[:space:]]*export/ {target=$$1; sub(/:$$/,"",target); printf "  %-28s %s\n", target, desc; desc=""}' $(MAKEFILE_LIST) | sort
	@echo ""

## Install dependencies and the development tools.
install: pyproject.toml
	$(UV) sync --group dev --quiet
	$(UV) run --quiet prek install

## Validate code{% if project_type == 'app' %}/config{% endif %}.
check:
	@$(UV) lock --check
{%- if is_template %}
	@$(UV) run --quiet python scripts/add_ruff_rule_links.py
	@$(UV) run --quiet python scripts/lint_makefile.py
{%- endif %}
	@$(UV) run --quiet python scripts/check.py

## Run tests{% if project_type == 'app' %}/integration tests{% endif %}.
test:
	@$(UV) run --quiet pytest -q

## Build {% if project_type == 'app' %}Docker image{% else %}wheel/sdist{% endif %}.
build:
{%- if project_type == "app" %}
	docker build -t {{ project_name_kebab_case }}:latest .
{%- else %}
	$(UV) build
{%- endif %}

# Mark the commands below as running in CI so tools that adapt to it can tell.
# An existing CI value wins, so a provider's own setting is never overwritten.
## Run check + test + build.
ci: export CI := $(if $(CI),$(CI),true)
ci: check test build

## Deploy application (app) or publish package (package).
cd: build
{%- if project_type == "app" %}
	@: $${REGISTRY:?set REGISTRY to the target registry, e.g. export REGISTRY=registry.example.com}
	docker tag {{ project_name_kebab_case }}:latest $$REGISTRY/{{ project_name_kebab_case }}:latest
	docker tag {{ project_name_kebab_case }}:latest $$REGISTRY/{{ project_name_kebab_case }}:$$(git rev-parse --short HEAD)
	docker push $$REGISTRY/{{ project_name_kebab_case }}:latest
	docker push $$REGISTRY/{{ project_name_kebab_case }}:$$(git rev-parse --short HEAD)
{%- else %}
	@echo "Publish not configured. Add your publish steps here."
	@echo "Example: uv publish"
{%- endif %}

## Remove build artifacts and untracked files (keeps the .venv folder and .env files).
clean:
	@$(UV) run --quiet python scripts/clean.py

## Initialize a Git repository, install dependencies, and create the initial commit.
init:
	@$(UV) run --quiet python scripts/init.py
{%- if not is_template %}
	@$(UV) run --quiet python scripts/update_github_metadata.py
	@$(UV) run --quiet python scripts/update_vscode_extensions.py
{%- endif %}


{%- if is_template %}

## Re-apply the template to this repo, rewriting the files it generates.
test-template:
	uvx --isolated --refresh --from copier@latest copier copy . . --overwrite --vcs-ref=HEAD --quiet \
		--data project_name=project_template \
		--data project_type=package \
		--data project_description="A Python package that does things." \
		--data python_version=3.12 \
		--data with_conventional_commits=true \
		--data typing=false \
		--data is_template=true
{%- endif %}

{%- if project_type == "app" %}

## Run the {{ project_name }} app.
run:
	$(UV) run --quiet {{ project_name_kebab_case }}
{%- endif %}
